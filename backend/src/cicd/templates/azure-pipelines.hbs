# Azure Pipelines — generated by Migration Tool
# Source framework : {{sourceFramework}}
# Target language  : {{targetLanguage}}
# Generated at     : {{generatedAt}}

trigger:
  branches:
    include:
      - main
      - develop

pool:
  vmImage: '{{#if (eq targetLanguage "java")}}ubuntu-latest{{else}}ubuntu-latest{{/if}}'

variables:
  NODE_VERSION: '20.x'
  JAVA_VERSION: '17'

stages:
  - stage: Build
    displayName: 'Build & Test'
    jobs:
      - job: RunTests
        displayName: 'Run Migrated Tests'
        steps:
          {{#if (eq targetLanguage "java")}}
          - task: JavaToolInstaller@0
            inputs:
              versionSpec: '$(JAVA_VERSION)'
              jdkArchitectureOption: 'x64'
              jdkSourceOption: 'PreInstalled'

          - script: mvn clean verify --no-transfer-progress
            displayName: 'Maven Build & Test'

          - task: PublishTestResults@2
            inputs:
              testResultsFormat: 'JUnit'
              testResultsFiles: '**/surefire-reports/TEST-*.xml'
              mergeTestResults: true
              failTaskOnFailedTests: true

          - task: PublishCodeCoverageResults@1
            inputs:
              codeCoverageTool: 'JaCoCo'
              summaryFileLocation: '**/jacoco.xml'
          {{else if (eq targetLanguage "python")}}
          - task: UsePythonVersion@0
            inputs:
              versionSpec: '3.11'

          - script: |
              pip install pytest pytest-cov
              pytest --cov=. --cov-report=xml --cov-report=term-missing
            displayName: 'Run pytest with coverage'

          - task: PublishTestResults@2
            inputs:
              testResultsFormat: 'JUnit'
              testResultsFiles: '**/test-results.xml'

          - task: PublishCodeCoverageResults@1
            inputs:
              codeCoverageTool: 'Cobertura'
              summaryFileLocation: '**/coverage.xml'
          {{else}}
          - task: NodeTool@0
            inputs:
              versionSpec: '$(NODE_VERSION)'

          - script: npm ci
            displayName: 'Install dependencies'

          - script: npx playwright install --with-deps
            displayName: 'Install Playwright browsers'

          - script: npx playwright test --reporter=junit
            displayName: 'Run Playwright tests'
            env:
              CI: 'true'

          - task: PublishTestResults@2
            inputs:
              testResultsFormat: 'JUnit'
              testResultsFiles: '**/test-results*.xml'
              mergeTestResults: true
              failTaskOnFailedTests: true

          - task: PublishPipelineArtifact@1
            inputs:
              targetPath: 'playwright-report'
              artifact: 'playwright-report'
            condition: always()
          {{/if}}

  - stage: Quality
    displayName: 'Quality Gate'
    dependsOn: Build
    jobs:
      - job: CoverageGate
        displayName: 'Enforce Coverage Thresholds'
        steps:
          - script: |
              echo "Line coverage: {{coverage.linePct}}%  (threshold: 90%)"
              echo "Branch coverage: {{coverage.branchPct}}%  (threshold: 85%)"
              {{#if coveragePasses}}
              echo "✓ Coverage thresholds passed"
              {{else}}
              echo "✗ Coverage below threshold — pipeline will continue but flag as warning"
              {{/if}}
            displayName: 'Coverage Summary'
