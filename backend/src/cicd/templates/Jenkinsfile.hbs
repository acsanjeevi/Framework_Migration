// Jenkinsfile (Declarative Pipeline) — generated by Migration Tool
// Source framework : {{sourceFramework}}
// Target language  : {{targetLanguage}}
// Generated at     : {{generatedAt}}

pipeline {
    agent any

    {{#if (eq targetLanguage "java")}}
    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }
    {{else if (eq targetLanguage "python")}}
    // Requires Python 3.11+ on agent PATH
    {{else}}
    tools {
        nodejs 'NodeJS20'
    }
    {{/if}}

    environment {
        CI = 'true'
        LINE_THRESHOLD   = '90'
        BRANCH_THRESHOLD = '85'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        {{#if (eq targetLanguage "java")}}
        stage('Build') {
            steps {
                sh 'mvn clean compile --no-transfer-progress'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn verify --no-transfer-progress'
            }
            post {
                always {
                    junit 'target/surefire-reports/TEST-*.xml'
                    jacoco(
                        execPattern: 'target/*.exec',
                        classPattern: 'target/classes',
                        sourcePattern: 'src/main/java',
                        lineCoverageMinimum: '90',
                        branchCoverageMinimum: '85'
                    )
                }
            }
        }

        {{else if (eq targetLanguage "python")}}
        stage('Install') {
            steps {
                sh '''
                    pip install --upgrade pip
                    pip install pytest pytest-cov
                    pip install -r requirements.txt || true
                '''
            }
        }

        stage('Test') {
            steps {
                sh 'pytest --cov=. --cov-report=xml:coverage.xml --cov-report=term-missing --junitxml=test-results.xml'
            }
            post {
                always {
                    junit 'test-results.xml'
                    cobertura(
                        coberturaReportFile: 'coverage.xml',
                        lineCoverageTargets: '90,0,0',
                        conditionalCoverageTargets: '85,0,0'
                    )
                }
            }
        }

        {{else}}
        stage('Install') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Install Browsers') {
            steps {
                sh 'npx playwright install --with-deps chromium'
            }
        }

        stage('Test') {
            steps {
                sh 'npx playwright test --reporter=junit,html'
            }
            post {
                always {
                    junit(
                        testResults: 'test-results/*.xml',
                        allowEmptyResults: true
                    )
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'Playwright Report'
                    ])
                }
            }
        }

        {{/if}}

        stage('Quality Gate') {
            steps {
                script {
                    def linePct   = {{coverage.linePct}}
                    def branchPct = {{coverage.branchPct}}
                    echo "Line coverage  : ${linePct}%  (threshold ${env.LINE_THRESHOLD}%)"
                    echo "Branch coverage: ${branchPct}% (threshold ${env.BRANCH_THRESHOLD}%)"
                    {{#unless coveragePasses}}
                    echo 'WARNING: Coverage below threshold'
                    {{/unless}}
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            echo 'Pipeline failed — check test reports above'
        }
        success {
            echo 'Pipeline succeeded'
        }
    }
}
