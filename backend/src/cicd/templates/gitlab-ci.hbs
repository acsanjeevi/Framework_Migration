# GitLab CI — generated by Migration Tool
# Source framework : {{sourceFramework}}
# Target language  : {{targetLanguage}}
# Generated at     : {{generatedAt}}

image: {{#if (eq targetLanguage "java")}}maven:3.9-eclipse-temurin-17{{else if (eq targetLanguage "python")}}python:3.11-slim{{else}}node:20-slim{{/if}}

stages:
  - build
  - test
  - quality

variables:
  CI: 'true'
  {{#if (eq targetLanguage "java")}}
  MAVEN_OPTS: '-Dmaven.repo.local=$CI_PROJECT_DIR/.m2/repository'
  {{else if (eq targetLanguage "python")}}
  PIP_CACHE_DIR: '$CI_PROJECT_DIR/.pip-cache'
  {{else}}
  NPM_CONFIG_CACHE: '$CI_PROJECT_DIR/.npm-cache'
  {{/if}}

cache:
  key: '${CI_COMMIT_REF_SLUG}'
  paths:
    {{#if (eq targetLanguage "java")}}
    - .m2/repository/
    {{else if (eq targetLanguage "python")}}
    - .pip-cache/
    {{else}}
    - node_modules/
    - .npm-cache/
    {{/if}}

{{#if (eq targetLanguage "java")}}
build:
  stage: build
  script:
    - mvn clean compile --no-transfer-progress
  artifacts:
    paths:
      - target/

test:
  stage: test
  script:
    - mvn verify --no-transfer-progress
  artifacts:
    reports:
      junit: target/surefire-reports/TEST-*.xml
      coverage_report:
        coverage_format: cobertura
        path: target/site/jacoco/jacoco.xml
    paths:
      - target/surefire-reports/
    expire_in: 1 week
  coverage: '/Total.*?([0-9]{1,3})%/'

{{else if (eq targetLanguage "python")}}
build:
  stage: build
  script:
    - pip install --upgrade pip
    - pip install pytest pytest-cov
    - pip install -r requirements.txt || true

test:
  stage: test
  script:
    - pytest --cov=. --cov-report=xml:coverage.xml --cov-report=term-missing --junitxml=test-results.xml
  artifacts:
    reports:
      junit: test-results.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml
    expire_in: 1 week
  coverage: '/TOTAL.*\s+(\d+%)$/'

{{else}}
build:
  stage: build
  script:
    - npm ci
  artifacts:
    paths:
      - node_modules/
    expire_in: 1 hour

test:
  stage: test
  before_script:
    - npx playwright install --with-deps chromium
  script:
    - npx playwright test --reporter=junit,html
  artifacts:
    reports:
      junit: test-results/*.xml
    paths:
      - playwright-report/
    expire_in: 1 week
  when: always

{{/if}}

quality-gate:
  stage: quality
  script:
    - echo "Line coverage   {{coverage.linePct}}%  (threshold 90%)"
    - echo "Branch coverage {{coverage.branchPct}}%  (threshold 85%)"
    {{#if coveragePasses}}
    - echo "Coverage thresholds passed"
    {{else}}
    - echo "WARNING - Coverage below threshold"
    {{/if}}
  allow_failure: {{#if coveragePasses}}false{{else}}true{{/if}}
